<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anthropic</groupId>
        <artifactId>claude-agent-sdk-java-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claude-agent-sdk-core</artifactId>
    <name>Claude Agent SDK for Java — Core</name>
    <description>Core SDK: subprocess transport, control protocol, message parsing, types</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            bundled-cli profile: activates an OS-specific classifier dependency so the
            matching binary JAR is on the classpath at runtime.

            Usage:
              mvn -B -ntp install -P bundled-cli        # auto-detect current OS
              mvn -B -ntp install -P bundled-cli,bundled-cli-linux-x86_64  # explicit
        -->
        <profile>
            <id>bundled-cli</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <dependencies>
                <!-- bundled-cli classifier: resolution picks the binary JAR matching
                     the current OS. Without -P bundled-cli, users must install `claude`
                     themselves or set ClaudeAgentOptions.cliPath. -->
                <dependency>
                    <groupId>com.anthropic</groupId>
                    <artifactId>claude-agent-sdk-core</artifactId>
                    <version>${project.version}</version>
                    <classifier>${claude.cli.detected.classifier}</classifier>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>bundled-cli-linux-x86_64</id>
            <activation><activeByDefault>false</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.anthropic</groupId>
                    <artifactId>claude-agent-sdk-core</artifactId>
                    <version>${project.version}</version>
                    <classifier>linux-x86_64</classifier>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>bundled-cli-linux-aarch64</id>
            <activation><activeByDefault>false</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.anthropic</groupId>
                    <artifactId>claude-agent-sdk-core</artifactId>
                    <version>${project.version}</version>
                    <classifier>linux-aarch64</classifier>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>bundled-cli-osx-x86_64</id>
            <activation><activeByDefault>false</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.anthropic</groupId>
                    <artifactId>claude-agent-sdk-core</artifactId>
                    <version>${project.version}</version>
                    <classifier>osx-x86_64</classifier>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>bundled-cli-osx-aarch64</id>
            <activation><activeByDefault>false</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.anthropic</groupId>
                    <artifactId>claude-agent-sdk-core</artifactId>
                    <version>${project.version}</version>
                    <classifier>osx-aarch64</classifier>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>bundled-cli-windows-x86_64</id>
            <activation><activeByDefault>false</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.anthropic</groupId>
                    <artifactId>claude-agent-sdk-core</artifactId>
                    <version>${project.version}</version>
                    <classifier>windows-x86_64</classifier>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
